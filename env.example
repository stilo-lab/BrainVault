# Discord Developer Portal → Bot → Token; niemals öffentlich teilen.
DISCORD_TOKEN=
# Optional: wird automatisch erkannt.
CLIENT_ID=
# Testserver-ID; leer = Befehle global registrieren
GUILD_ID=
DB_PATH=data/sab.sqlite

# 7ask / !ask: zusätzlich Message Content Intent im Developer Portal aktivieren!
# /ask bleibt auch mit false verfügbar.
TEXT_COMMANDS=true
# Normale Fragen im mit /sab kanal gewählten Fragekanal beantworten.
CHAT_AUTO_REPLY=false
# W-or-L-Bildfragen im mit /trade kanal gewählten Kanal erkennen.
WFL_AUTO_REPLY=true
# Invite-Rewards: zusätzlich Server Members Intent im Developer Portal aktivieren.
INVITES_ENABLED=true
# Befehle bei Änderungen automatisch registrieren, auch auf Railway.
AUTO_DEPLOY_COMMANDS=true
# Bilder-/Sticker-Trading-Kanal moderieren; Message Content Intent erforderlich.
TRADING_MEDIA_ENABLED=true
# Ein gemeinsames W/L-/Value-Kontingent pro Tag. Unlimited: discord.gg/Z3fq8Uu2cU
# Der Bot muss selbst ebenfalls in diesem Server installiert sein.
# Kein KI-API-Schlüssel erforderlich.
